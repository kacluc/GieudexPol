@startuml
actor User as U
participant "Frontend (Angular)" as FE
participant "API (TransactionsController)" as API
participant "Application (TransactionService)" as App
participant "Infrastructure (UserRepository)" as UserRepo
participant "Infrastructure (WalletRepository)" as WalletRepo
participant "Infrastructure (TransactionFeeRepository)" as FeeRepo
participant "Domain (Transaction, User, Wallet, TransactionFee)" as Domain
participant "Database (SQL Server)" as DB

U -> FE: Initiates money transfer (Receiver Username, Amount, Currency)
FE -> API: POST /api/transactions/transfer (TransferRequest)
API -> UserRepo: GetByAuthId(JWT NameIdentifier)
UserRepo -> DB: SELECT * FROM Users WHERE AuthId = @AuthId
DB --> UserRepo: Authenticated Sender
UserRepo --> API: Sender User
API -> App: CreateTransfer(SenderId, TransferRequest)

App -> FeeRepo: GetActiveTransactionFeeByTypeAsync("Transfer")
FeeRepo -> DB: SELECT * FROM TransactionFees WHERE Type = "Transfer" AND IsActive = TRUE
DB --> FeeRepo: TransactionFee Data
FeeRepo --> App: TransactionFee

App -> App: Calculate total amount to deduct (Amount + Fee)

App -> UserRepo: GetUserByUsername(ReceiverUsername)
UserRepo -> DB: SELECT * FROM Users WHERE Username = @ReceiverUsername
DB --> UserRepo: Receiver User Data
UserRepo --> App: Receiver User

App -> WalletRepo: GetUserWallet(SenderId, CurrencyId)
WalletRepo -> DB: SELECT * FROM Wallets WHERE UserId = @SenderId AND CurrencyId = @CurrencyId
DB --> WalletRepo: Sender Wallet Data
WalletRepo --> App: Sender Wallet

alt Insufficient Balance or Invalid Receiver
    App --> API: Throws exception / Returns error
    API --> FE: 400 Bad Request / Error message
    FE --> U: Displays error
else Successful Validation
    App -> Domain: Create completed Transaction object
    App -> WalletRepo: ExecuteTransferAsync(SenderWalletId, ReceiverId, CurrencyId, Amount, Fee, Transaction)
    WalletRepo -> DB: BEGIN TRANSACTION
    WalletRepo -> DB: Debit sender by Amount + Fee
    WalletRepo -> DB: Create receiver wallet if missing
    WalletRepo -> DB: Credit receiver by Amount
    WalletRepo -> DB: INSERT completed Transaction
    WalletRepo -> DB: COMMIT
    DB --> WalletRepo: Transfer committed
    WalletRepo --> App: Transaction with Id

    App --> API: Return successful Transaction details
    API --> FE: 200 OK / Transaction details
    FE --> U: Displays success message and updated balances
end

@enduml
