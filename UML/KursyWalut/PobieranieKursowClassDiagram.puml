@startuml
title Modul kursow walut - diagram klas
skinparam classAttributeIconSize 0
hide empty members

package "Frontend Angular" {
  class ExchangeRateDashboard {
    - currency: string
    - source: string
    - from: string
    - to: string
    - chartPoints: ExchangeRateChartPoint[]
    - latestRates: ExchangeRateTableRow[]
    + fetchData(): Promise<void>
  }

  class ExchangeRateApiService {
    + getChartData(currency, source, from, to)
    + getLatestRates(source)
    + syncNbpRates(from, to)
  }
}

package "API" {
  class ExchangeRatesController {
    - SyncableSources: HashSet<string>
    - SyntheticRateSources: HashSet<string>
    + GetChartData(currency, source, from, to)
    + GetLatestRates(source, currency)
    + SyncRatesBySource(sourceCode, from, to)
  }

  class ExchangeRateStartupSyncService {
    - SourceCodes: string[]
    + ExecuteAsync(cancellationToken)
    - SynchronizeSourceIfRequiredAsync(...)
  }
}

package "Application" {
  interface IExchangeRateService
  interface IExchangeRateSyncService
  interface IExchangeRateRepository
  interface IExternalExchangeRateClient {
    + SourceCode: string
    + SourceName: string
    + MaxRangeDays: int
    + GetBuySellRatesAsync(from, to, cancellationToken)
  }

  class ExchangeRateService
  class ExchangeRateSpreadCalculator {
    {static} + CalculateSyntheticBidAsk(referenceRate, spreadPercent)
  }
  class ExchangeRateSettings {
    + SyntheticSpreadPercent: decimal = 0.02
  }

  class ExternalExchangeRateItemDto {
    + CurrencyCode: string
    + CurrencyName: string
    + BuyPrice: decimal
    + SellPrice: decimal
    + ReferenceRate: decimal?
  }

  class ExchangeRateChartPointDto {
    + Date: DateTime
    + BuyPrice: decimal
    + MidPrice: decimal?
    + SellPrice: decimal
  }

  class ExchangeRateTableRowDto {
    + CurrencyCode: string
    + SourceCode: string
    + EffectiveDate: DateTime
    + BuyPrice: decimal
    + MidPrice: decimal?
    + SellPrice: decimal
  }
}

package "Infrastructure" {
  class ExchangeRateSyncService {
    - SyntheticRateSourceCodes: HashSet<string>
    - SyncLocks: ConcurrentDictionary
    + SyncRatesAsync(sourceCode, from, to, cancellationToken)
    + SyncCurrentYearRatesAsync(sourceCode, cancellationToken)
    - GetStoredPrices(sourceCode, rate)
    - LoadExistingRatesAsync(...)
    - SplitIntoRanges(...)
  }

  class ExchangeRateRepository
  class ApplicationDbContext
}

package "Domain" {
  class Currency {
    + Id: int
    + Symbol: string
    + Name: string
  }

  class RateSource {
    + Id: int
    + Code: string
    + Name: string
  }

  class ExchangeRate {
    + Id: int
    + CurrencyId: int
    + RateSourceId: int
    + BuyPrice: decimal
    + MidPrice: decimal?
    + SellPrice: decimal
    + EffectiveDate: DateTime
    + FetchedAt: DateTime
  }
}

ExchangeRateDashboard --> ExchangeRateApiService
ExchangeRateApiService --> ExchangeRatesController : HTTP
ExchangeRatesController --> IExchangeRateService
ExchangeRatesController --> IExchangeRateSyncService
ExchangeRateStartupSyncService --> IExchangeRateSyncService

IExchangeRateService <|.. ExchangeRateService
IExchangeRateSyncService <|.. ExchangeRateSyncService
IExchangeRateRepository <|.. ExchangeRateRepository

ExchangeRateService --> IExchangeRateRepository
ExchangeRateRepository --> ApplicationDbContext
ExchangeRateSyncService --> ApplicationDbContext
ExchangeRateSyncService --> IExternalExchangeRateClient
ExchangeRateSyncService --> ExchangeRateSpreadCalculator
ExchangeRateSyncService --> ExchangeRateSettings
IExternalExchangeRateClient --> ExternalExchangeRateItemDto

ApplicationDbContext --> Currency
ApplicationDbContext --> RateSource
ApplicationDbContext --> ExchangeRate
Currency "1" -- "many" ExchangeRate
RateSource "1" -- "many" ExchangeRate

note right of ExchangeRate
Unikalnosc:
CurrencyId + RateSourceId + EffectiveDate

Wszystkie ceny oznaczaja PLN
za 1 jednostke waluty.
end note
@enduml
