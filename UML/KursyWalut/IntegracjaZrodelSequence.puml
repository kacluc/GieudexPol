@startuml
title Integracja z dostawcami kursow

participant "ExchangeRateSyncService" as Sync
participant "IExternalExchangeRateClient" as Client
participant "Zewnetrzny dostawca" as Provider
participant "ExchangeRateSpreadCalculator" as Calculator
database "ApplicationDbContext" as Db

Sync -> Sync: wybierz klienta po SourceCode
Sync -> Sync: przejmij blokade per zrodlo

loop zakresy wedlug MaxRangeDays
  Sync -> Client: GetBuySellRatesAsync(rangeFrom, rangeTo)

  alt NBP tabela C
    Client -> Provider: GET JSON table C
    Provider --> Client: bid, ask, effectiveDate
    Client --> Sync: BuyPrice=bid, SellPrice=ask
    Sync -> Sync: MidPrice = round((bid + ask) / 2, 4)
  else ECB
    Client -> Provider: GET eurofxref-hist.xml
    Provider --> Client: kursy wzgledem EUR
    Client -> Client: ReferenceRate = EUR_PLN / EUR_CURRENCY
    Client --> Sync: ReferenceRate w PLN
  else RIKSBANK
    Client -> Provider: GET Observations/ByGroup/130/{from}/{to}
    Provider --> Client: kursy wzgledem SEK
    Client -> Client: ReferenceRate = SEK_CURRENCY / SEK_PLN
    Client --> Sync: ReferenceRate w PLN
  else BOE
    Client -> Provider: GET eksport CSV spot
    Provider --> Client: kursy wzgledem GBP
    Client -> Client: ReferenceRate = GBP_PLN / GBP_CURRENCY
    Client --> Sync: ReferenceRate w PLN
  else CNB
    Client -> Provider: GET exrates/daily?date=...
    Provider --> Client: amount i rate w CZK
    Client -> Client: ReferenceRate = CurrencyToCZK / PLNToCZK
    Client --> Sync: ReferenceRate w PLN
  else NORGES
    Client -> Provider: GET SDMX-JSON EXR
    Provider --> Client: unit i rate w NOK
    Client -> Client: ReferenceRate = CurrencyToNOK / PLNToNOK
    Client --> Sync: ReferenceRate w PLN
  else BNR
    Client -> Provider: GET nbrfxrates{year}.xml
    Provider --> Client: multiplier i rate w RON
    Client -> Client: ReferenceRate = CurrencyToRON / PLNToRON
    Client --> Sync: ReferenceRate w PLN
  end

  opt source != NBP
    Sync -> Calculator: CalculateSyntheticBidAsk(referenceRate, spread)
    Calculator --> Sync: BuyPrice < SellPrice, round 4
    Sync -> Sync: MidPrice = round(referenceRate, 4)
  end

  Sync -> Db: znajdz/utworz RateSource i Currency
  alt nowy klucz Currency + Source + Date
    Sync -> Db: INSERT ExchangeRate
  else istniejacy kurs syntetyczny
    Sync -> Db: UPDATE BuyPrice, MidPrice, SellPrice
  else istniejacy kurs NBP
    Sync -> Sync: pomin bez nadpisywania bid/ask
  end
end

Sync -> Db: SaveChangesAsync()
Sync -> Sync: zwolnij blokade SourceCode
@enduml
