@startuml
title Integracja zrodel kursow - diagram klas
skinparam classAttributeIconSize 0
hide empty members

interface IExternalExchangeRateClient {
  + SourceCode: string
  + SourceName: string
  + MaxRangeDays: int
  + GetBuySellRatesAsync(from, to, cancellationToken)
}

class NbpExchangeRateClient {
  + SourceCode = "NBP"
  + MaxRangeDays = 93
}

class EcbExchangeRateClient {
  + SourceCode = "ECB"
  + MaxRangeDays = 366
  + ParseHistoricalRates(...)
}

class RiksbankExchangeRateClient {
  + SourceCode = "RIKSBANK"
  + MaxRangeDays = 366
  + ParseGroupObservations(...)
}

class BankOfEnglandExchangeRateClient {
  + SourceCode = "BOE"
  + MaxRangeDays = 366
  + ParsePublishedSpotRates(...)
}

class CnbExchangeRateClient {
  + SourceCode = "CNB"
  + MaxRangeDays = 31
  + ParseDailyRates(...)
}

class NorgesExchangeRateClient {
  + SourceCode = "NORGES"
  + MaxRangeDays = 366
  + ParseDailyObservations(...)
}

class BnrExchangeRateClient {
  + SourceCode = "BNR"
  + MaxRangeDays = 366
  + ParsePublishedRates(...)
}

class ExternalExchangeRateTableDto {
  + EffectiveDate: DateTime
  + Rates: List<ExternalExchangeRateItemDto>
}

class ExternalExchangeRateItemDto {
  + CurrencyCode: string
  + BuyPrice: decimal
  + SellPrice: decimal
  + ReferenceRate: decimal?
}

class ExchangeRateSyncService {
  - SyntheticRateSourceCodes: HashSet<string>
  + SyncRatesAsync(sourceCode, from, to, cancellationToken)
  - GetStoredPrices(sourceCode, rate)
}

class ExchangeRateSpreadCalculator {
  {static} + CalculateSyntheticBidAsk(referenceRate, spreadPercent)
}

class ExchangeRateSettings {
  + SyntheticSpreadPercent: decimal = 0.02
}

IExternalExchangeRateClient <|.. NbpExchangeRateClient
IExternalExchangeRateClient <|.. EcbExchangeRateClient
IExternalExchangeRateClient <|.. RiksbankExchangeRateClient
IExternalExchangeRateClient <|.. BankOfEnglandExchangeRateClient
IExternalExchangeRateClient <|.. CnbExchangeRateClient
IExternalExchangeRateClient <|.. NorgesExchangeRateClient
IExternalExchangeRateClient <|.. BnrExchangeRateClient

NbpExchangeRateClient --> ExternalExchangeRateTableDto : JSON bid/ask
EcbExchangeRateClient --> ExternalExchangeRateTableDto : XML EUR -> PLN
RiksbankExchangeRateClient --> ExternalExchangeRateTableDto : JSON SEK -> PLN
BankOfEnglandExchangeRateClient --> ExternalExchangeRateTableDto : CSV GBP -> PLN
CnbExchangeRateClient --> ExternalExchangeRateTableDto : JSON CZK -> PLN
NorgesExchangeRateClient --> ExternalExchangeRateTableDto : SDMX NOK -> PLN
BnrExchangeRateClient --> ExternalExchangeRateTableDto : XML RON -> PLN
ExternalExchangeRateTableDto "1" *-- "many" ExternalExchangeRateItemDto

ExchangeRateSyncService --> IExternalExchangeRateClient : wybiera po SourceCode
ExchangeRateSyncService --> ExchangeRateSpreadCalculator
ExchangeRateSyncService --> ExchangeRateSettings

note right of NbpExchangeRateClient
Tabela C:
BuyPrice = bid
SellPrice = ask
Bez sztucznego spreadu.
end note

note right of ExchangeRateSpreadCalculator
ECB, RIKSBANK, BOE, CNB,
NORGES i BNR:

Buy = ReferenceRate * (1 - spread/2)
Sell = ReferenceRate * (1 + spread/2)

Zaokraglenie: 4 miejsca.
Minimalny krok: 0.0001.
end note
@enduml
